{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:eslint && npm run lint:stylelint",
    "lint:ci": "npm run lint:eslint:ci && npm run lint:stylelint:ci",
    "lint:eslint": "eslint . --fix --cache",
    "lint:eslint:ci": "eslint .",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue}\" --fix --cache",
    "lint:stylelint:ci": "stylelint \"**/*.{css,scss,vue}\"",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
